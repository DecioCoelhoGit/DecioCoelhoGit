bash -n renomear_hologramas.sh
./renomear_hologramas_v4.sh
#!/data/data/com.termux/files/usr/bin/bash
set -euo pipefail

ROOT_DIR="."
LOG_FILE="$ROOT_DIR/renomear_hologramas.log"
MAP_FILE="$(mktemp)"
TIMESTAMP="$(date '+%Y-%m-%d %H:%M:%S')"

: > "$LOG_FILE"

log() {
  echo "$1" | tee -a "$LOG_FILE"
}

fail() {
  log "ERRO: $1"
  rm -f "$MAP_FILE"
  exit 1
}

header() {
  echo
  echo "=========================================="
  echo " EVBMT :: RENOMEADOR V4 SISTEMA"
  echo "=========================================="
  echo
}

gerar_mapa() {
